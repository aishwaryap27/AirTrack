# ==============================================================================
# AirTrack Production Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env on your host or EC2 instance:
#   cp .env.example .env
#
# Docker Compose will automatically read variables defined in .env.
# ==============================================================================

# Application & Debug Mode
PROJECT_NAME=AirTrack — Air Traffic Data Management and Analytics
DEBUG=False

# Host HTTP Port exposed on the EC2 host (default: 80)
PORT=80

# API Routing Prefix
API_PREFIX=/api

# Internal MongoDB Configuration (Docker Network)
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=AirTrafficDB

# CORS Allowed Origins
# For same-origin Nginx deployment, wildcard '*' is standard because the browser
# communicates directly with Nginx on port 80. Credentials are disabled when wildcard is used.
# If accessing from external frontends or specific domains, specify comma-separated origins:
# CORS_ORIGINS=http://your-domain.com,https://your-domain.com
CORS_ORIGINS=*
